# Copy to .env for local Compose use. Replace every placeholder before starting.
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=HelpDesk.Api
JWT_AUDIENCE=HelpDesk.Clients
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
BOOTSTRAP_ADMIN_EMAIL=admin@company.example
BOOTSTRAP_ADMIN_FULL_NAME=Help Desk Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
